OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
# Optional tier-specific deployments. If unset, all tiers use OPENAI_MODEL.
DEEPRESEARCH_LITE_MODEL=deepseek-v4-flash
DEEPRESEARCH_DEFAULT_MODEL=deepseek-v4-flash
DEEPRESEARCH_CRAFT_MODEL=deepseek-v4-pro
TAVILY_API_KEY=
OPENLUX_API_KEY=
OPENLUX_BASE_URL=https://api.openlux.ai
DEEPSEEK_API_KEY=
ANYSEARCH_API_KEY=
# Legacy/optional 2xa-compatible endpoint; not used by the default routing.
X2A_API_KEY=
X2A_BASE_URL=
# Set to 1 for a DeepSeek-only search-provider A/B run.
DEEPRESEARCH_DISABLE_TAVILY=0
DEEPRESEARCH_DISABLE_DUCKDUCKGO=0
DEEPRESEARCH_DISABLE_WIKIPEDIA=0
# DeepSeek and AnySearch MCP search are enabled by the active Profile. Their
# API keys are read directly from the process environment.

# Read-only local document Skill. Separate multiple roots with the platform
# path separator (';' on Windows, ':' on Linux/macOS).
DEEPRESEARCH_FILE_ROOTS=.
DEEPRESEARCH_FILE_MAX_BYTES=10485760

# Optional browser executable for Scrapling's JavaScript-page fallback.
# Common Windows Chrome/Edge locations are auto-discovered when left empty.
SCRAPLING_EXECUTABLE_PATH=

# Optional. Enables Unpaywall DOI resolution in drb_evaluation fetch fallback.
UNPAYWALL_EMAIL=

# Bundled SageResearch-compatible academic and GitHub MCP connectors.
DEEPRESEARCH_ENABLE_RESEARCH_MCP=0
GITHUB_TOKEN=
SERPAPI_KEY=
OPENALEX_EMAIL=
# Optional. Public OpenAlex requests work without it; set this only if your
# OpenAlex account or deployment issues an API key.
OPENALEX_API_KEY=
DEEPRESEARCH_SEARCH_PROVIDER=duckduckgo
DEEPRESEARCH_ARTIFACT_ROOT=artifacts
DEEPRESEARCH_CHECKPOINT_DB=.runtime/checkpoints.sqlite
DEEPRESEARCH_REDIS_URL=
